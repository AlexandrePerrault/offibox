<Project Sdk="WixToolset.Sdk/6.0.0">

  <!-- Ne compiler que Package.wxs (v4) : éviter que le SDK inclue Harvest.wxs / Product.wxs.v3 (v3). -->
  <PropertyGroup>
    <EnableDefaultItems>false</EnableDefaultItems>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Package.wxs" />
  </ItemGroup>

  <PropertyGroup>
    <OutputPath>..\website\download</OutputPath>
    <PackageFileName>Offibox-Setup.1.1.24.msi</PackageFileName>
    <ReleaseFullPath>$([System.IO.Path]::GetFullPath('$(MSBuildProjectDirectory)/../build/windows/x64/runner/Release'))</ReleaseFullPath>
    <!-- Installation sous LocalAppData : ICE64, ICE38, ICE91 (per-user), ICE60 (font/language) -->
    <SuppressIces>ICE38;ICE60;ICE64;ICE91</SuppressIces>
    <!-- Heat : .exe/.dll Flutter ne sont pas des assemblies .NET -->
    <HarvestDirectorySuppressSpecificWarnings>5151</HarvestDirectorySuppressSpecificWarnings>
    <!-- Résolution des chemins récoltés : SourceDir = chemin absolu Release (évite MSI vide ~111 Ko) -->
    <DefineConstants>$(DefineConstants);ReleaseDir=$(ReleaseFullPath)</DefineConstants>
  </PropertyGroup>

  <!-- Inclure tous les fichiers du dossier Release (après flutter build windows) -->
  <ItemGroup>
    <HarvestDirectory Include="../build/windows/x64/runner/Release">
      <ComponentGroupName>ReleaseFiles</ComponentGroupName>
      <DirectoryRefId>INSTALLDIR</DirectoryRefId>
      <SuppressRootDirectory>true</SuppressRootDirectory>
      <PreprocessorVariable>var.ReleaseDir</PreprocessorVariable>
    </HarvestDirectory>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="WixToolset.Heat" Version="[6.0.0,)" />
    <PackageReference Include="WixToolset.UI.wixext" Version="[6.0.0,)" />
  </ItemGroup>

</Project>
