<?xml version="1.0" encoding="UTF-8"?>
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi">
  <Product Id="*"
           Name="Offibox"
           Language="1033"
           Version="1.1.24"
           Manufacturer="Offibox"
           UpgradeCode="B7B3E8A2-9F4C-4D1E-8A5B-2C6D9E1F3A4B">

    <Package InstallerVersion="500" Compressed="yes" InstallScope="perUser" />

    <MajorUpgrade DowngradeErrorMessage="Une version plus récente d'Offibox est déjà installée." />
    <MediaTemplate EmbedCab="yes" />

    <!-- Propriétés pour options (cases à cocher). Valeur 1 = coché par défaut. -->
    <Property Id="CREATEDESKTOPSHORTCUT" Value="1" />
    <Property Id="LAUNCHATSTARTUP" Value="1" />
    <Property Id="LAUNCHOFFIBOX" Value="1" />

    <!-- Répertoire d'installation : AppData\Local\Offibox (sans admin) -->
    <Directory Id="TARGETDIR" Name="SourceDir">
      <Directory Id="LocalAppDataFolder" Name="AppData">
        <Directory Id="INSTALLDIR" Name="Offibox" />
      </Directory>
      <Directory Id="ProgramMenuFolder">
        <Directory Id="ApplicationProgramsFolder" Name="Offibox" />
      </Directory>
      <Directory Id="DesktopFolder" Name="Desktop" />
    </Directory>

    <!-- Arbre de fonctionnalités : toutes cochables. Main = fichiers + menu Démarrer ; Bureau = icône bureau. -->
    <Feature Id="MainApplication" Title="Offibox" Level="1" ConfigurableDirectory="INSTALLDIR"
             Description="Application Offibox et raccourci Menu Démarrer.">
      <ComponentGroupRef Id="ReleaseFiles" />
      <ComponentRef Id="ApplicationShortcut" />
      <ComponentRef Id="RegistryLaunchAtStartup" />
    </Feature>
    <Feature Id="FeatureDesktopShortcut" Title="Créer une icône sur le bureau" Level="1"
             Description="Place un raccourci Offibox sur le bureau.">
      <ComponentRef Id="DesktopShortcut" />
    </Feature>

    <!-- Raccourci Menu Démarrer -->
    <DirectoryRef Id="ApplicationProgramsFolder">
      <Component Id="ApplicationShortcut" Guid="A1B2C3D4-E5F6-7890-ABCD-EF1234567890">
        <Shortcut Id="StartMenuShortcut"
                  Name="Offibox"
                  Description="La Boîte à Outils de l'Officine"
                  Target="[INSTALLDIR]offibox.exe"
                  WorkingDirectory="INSTALLDIR" />
        <RemoveFolder Id="RemoveApplicationProgramsFolder" Directory="ApplicationProgramsFolder" On="uninstall" />
        <RegistryValue Root="HKCU" Key="Software\Offibox" Name="installed" Type="integer" Value="1" KeyPath="yes" />
      </Component>
    </DirectoryRef>

    <!-- Raccourci Bureau (installé seulement si feature bureau sélectionnée) -->
    <DirectoryRef Id="DesktopFolder">
      <Component Id="DesktopShortcut" Guid="B2C3D4E5-F6A7-8901-BCDE-F12345678901">
        <Condition>CREATEDESKTOPSHORTCUT</Condition>
        <Shortcut Id="DesktopShortcut"
                  Name="Offibox"
                  Description="La Boîte à Outils de l'Officine"
                  Target="[INSTALLDIR]offibox.exe"
                  WorkingDirectory="INSTALLDIR" />
        <RegistryValue Root="HKCU" Key="Software\Offibox" Name="DesktopShortcut" Type="integer" Value="1" KeyPath="yes" />
      </Component>
    </DirectoryRef>

    <!-- Écriture LaunchAtStartup pour l'app (lue au premier lancement dans main.dart). -->
    <DirectoryRef Id="INSTALLDIR">
      <Component Id="RegistryLaunchAtStartup" Guid="C3D4E5F6-A7B8-9012-CDEF-123456789012">
        <Condition>LAUNCHATSTARTUP</Condition>
        <RegistryValue Root="HKCU" Key="Software\Offibox" Name="LaunchAtStartup" Type="integer" Value="1" KeyPath="yes" />
      </Component>
    </DirectoryRef>

    <!-- Lancer Offibox à la fin de l'installation si coché (nécessite -ext WixUtilExtension au light). -->
    <CustomAction Id="SetLaunchOffiboxCmd" Property="WixQuietExecCmdLine" Value="&quot;[INSTALLDIR]offibox.exe&quot;" />
    <CustomAction Id="LaunchOffibox" BinaryKey="WixCA" DllEntry="WixQuietExec" Execute="deferred" Return="ignore" />
    <InstallExecuteSequence>
      <Custom Action="SetLaunchOffiboxCmd" Before="LaunchOffibox">LAUNCHOFFIBOX AND NOT Installed</Custom>
      <Custom Action="LaunchOffibox" After="InstallFinalize">LAUNCHOFFIBOX AND NOT Installed</Custom>
    </InstallExecuteSequence>

    <!-- UI : arbre de fonctionnalités + dialogue options (Lancer au démarrage) + exit (Lancer Offibox). -->
    <UI>
      <UIRef Id="WixUI_FeatureTree" />
      <!-- Après "Personnaliser" (CustomizeDlg), afficher le dialogue Options. Back/Next de CustomOptionsDlg sont définis dans le Fragment ci-dessous. -->
      <Publish Dialog="CustomizeDlg" Control="Next" Event="NewDialog" Value="CustomOptionsDlg">1</Publish>
    </UI>
    <Property Id="WIXUI_EXITDIALOGOPTIONALCHECKBOX" Value="1" />
    <Property Id="WIXUI_EXITDIALOGOPTIONALCHECKBOXTEXT" Value="Lancer Offibox" />
  </Product>

  <!-- Dialogue personnalisé : options Lancer au démarrage + Lancer à la fin (toutes deux cochables). -->
  <Fragment>
    <UI>
      <Dialog Id="CustomOptionsDlg" Width="370" Height="270" Title="[ProductName] - Options">
        <Control Id="OptionsTitle" Type="Text" X="15" Y="6" Width="340" Height="15" Transparent="yes" NoPrefix="yes" Text="Choisissez les options d'installation." />
        <Control Id="CheckboxLaunchAtStartup" Type="CheckBox" X="20" Y="40" Width="330" Height="30" Property="LAUNCHATSTARTUP" CheckBoxValue="1" Text="Lancer Offibox au démarrage de Windows (recommandé)" />
        <Control Id="CheckboxLaunchNow" Type="CheckBox" X="20" Y="75" Width="330" Height="30" Property="LAUNCHOFFIBOX" CheckBoxValue="1" Text="Lancer Offibox à la fin de l'installation" />
        <Control Id="Back" Type="PushButton" X="180" Y="243" Width="56" Height="17" Text="&amp;Retour">
          <Publish Event="NewDialog" Value="CustomizeDlg">1</Publish>
        </Control>
        <Control Id="Next" Type="PushButton" X="236" Y="243" Width="56" Height="17" Default="yes" Text="&amp;Suivant">
          <Publish Event="NewDialog" Value="VerifyReadyDlg">1</Publish>
        </Control>
        <Control Id="Cancel" Type="PushButton" X="304" Y="243" Width="56" Height="17" Cancel="yes" Text="Annuler">
          <Publish Event="SpawnDialog" Value="CancelDlg">1</Publish>
        </Control>
      </Dialog>
    </UI>
  </Fragment>
</Wix>
