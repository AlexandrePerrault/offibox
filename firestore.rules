rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // 🔐 USERS
    match /users/{userId} {
      allow read, write: if request.auth != null
                         && request.auth.uid == userId;

      // 🔐 DEVICES SUBCOLLECTION
      match /devices/{deviceId} {
        allow read, write: if request.auth != null
                           && request.auth.uid == userId;
      }

      // 🔐 WEB SESSIONS (limite 5 connexions web simultanées par utilisateur)
      match /web_sessions/{sessionId} {
        allow read, write: if request.auth != null
                           && request.auth.uid == userId;
      }
    }

    // 🔐 CAHIER DE LIAISON (partagé par officine : même pharmacyNameNormalized = même groupe)
    match /cahier_liaison/{groupId}/entries/{entryId} {
      allow read: if request.auth != null
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.pharmacyNameNormalized == groupId;
      allow create: if request.auth != null
        && request.resource.data.authorUid == request.auth.uid
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.pharmacyNameNormalized == groupId;
      allow update, delete: if request.auth != null
        && resource.data.authorUid == request.auth.uid;
    }
  }
}
