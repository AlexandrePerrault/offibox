# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/
.tmp/
ephemeral/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# OAuth credentials (ne pas commiter)
config/oauth_credentials.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Ne jamais commiter les codes/tokens GitHub locaux
lib/data/GITHUB CODES.txt

# Firebase / Google (clés API - ne jamais commiter)
android/app/google-services.json
ios/Runner/GoogleService-Info.plist
firebase-export/serviceAccountKey.json

# WiX v3 : Harvest.wxs est généré par build_msi.ps1 (Heat). Ne pas committer pour éviter que le build v4 en CI le compile (namespace v3).
installer/wix/Harvest.wxs

# NuGet local (Windows build helper)
tools/nuget.exe

# Installateurs Windows (générés en local / CI, ne pas committer)
website/download/*.exe
